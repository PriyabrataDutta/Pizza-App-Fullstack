# Copy to .env.local and fill in. Never commit real values.
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project. Server-only: never prefix with NEXT_PUBLIC_ and never ship the service-role key to a browser or APK.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
